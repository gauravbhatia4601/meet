# Client environment variables (Vite). Copy to .env for local dev, or set in
# the Vercel project dashboard (Settings > Environment Variables).

# Origin of the signaling server (Node + Socket.io). Required in production
# because the client is served statically (e.g. on Vercel) and cannot reach the
# server on the same origin. Leave empty in local dev where the Vite proxy
# forwards /api and /socket.io to the local server.
# Example: https://meet-signal.up.railway.app
VITE_SERVER_URL=
