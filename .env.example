# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# Server
NODE_ENV=production
PORT=3001

# Public origin of the app (must be HTTPS for WebRTC/camera).
CLIENT_ORIGIN=https://meet.example.com

# --- Reverse proxy ---
# Caddy automatically provisions a Let's Encrypt cert for this domain.
CADDY_DOMAIN=meet.example.com

# --- TURN relay (REQUIRED for reliable calls on the public internet) ---
# Self-hosted coturn example:
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=meet
TURN_CREDENTIAL=change-me

# --- Cloudflare Calls (alternative to a static TURN server) ---
# Get these from https://dash.cloudflare.com -> Calls -> TURN.
# When set, the server mints short-lived TURN/STUN credentials on the fly and
# the static TURN_* vars above are ignored.
#CLOUDFLARE_TURN_TOKEN_ID=
#CLOUDFLARE_TURN_API_TOKEN=
#CLOUDFLARE_TURN_TTL=86400
