# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# Server
NODE_ENV=production
PORT=4123

# Public origin of the app (must be HTTPS for WebRTC/camera).
CLIENT_ORIGIN=https://meet.heygauravbhatia.com

# --- TURN relay (REQUIRED for reliable calls on the public internet) ---
# TURN/STUN URLs are fetched from the Cloudflare API on the fly, so no TURN
# URL variables are needed. Only set the Cloudflare credentials below.
# Get these from https://dash.cloudflare.com -> Calls -> TURN.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Optional: credential lifetime in seconds (default 86400 = 24h).
CLOUDFLARE_TURN_TTL=86400

# --- Room persistence (Redis) ---
# Point at your Redis instance so meeting codes survive an empty call / server
# restart (lets a link be reopened later, like Google Meet). Unset = in-memory
# only (dev). Example for a Coolify Redis container: redis://redis:6379
REDIS_URL=
# How long a code stays valid after the last person leaves (seconds). 604800 = 7 days.
ROOM_TTL_SECONDS=604800
