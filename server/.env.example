# Server environment variables.
# Copy to .env and adjust for your deployment.

# Port the server listens on.
PORT=3001

# Allowed browser origin (the client). Used for CORS + Socket.io.
# In dev, Vite proxies to the server so this can stay at the Vite URL.
CLIENT_ORIGIN=http://localhost:5173

# production | development
NODE_ENV=development

# --- WebRTC TURN (required for reliable calls on the public internet) ---
# STUN is always enabled. TURN/STUN URLs are fetched from the Cloudflare API
# on the fly for each /api/rtc-config request, so no TURN URL variables are
# needed. Only set the Cloudflare credentials below.
# Get these from the Cloudflare dashboard (Realtime > TURN).
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Optional: credential lifetime in seconds (default 86400 = 24h).
CLOUDFLARE_TURN_TTL=86400
