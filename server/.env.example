# Server environment variables.
# Copy to .env and adjust for your deployment.

# Port the server listens on.
PORT=3001

# Allowed browser origin (the client). Used for CORS + Socket.io.
# In dev, Vite proxies to the server so this can stay at the Vite URL.
CLIENT_ORIGIN=http://localhost:5173

# production | development
NODE_ENV=development

# --- WebRTC TURN (required for reliable calls on the public internet) ---
# STUN is always enabled. Add a TURN server so calls work behind strict
# NATs/firewalls (e.g. most mobile networks, corporate networks). Without a
# TURN server, peer-to-peer calls may fail to connect on the public internet.

# Option 1 (recommended): Cloudflare TURN. The server calls Cloudflare's API
# to mint short-lived credentials on the fly for each /api/rtc-config request,
# so credentials never ship in the client bundle and rotate automatically.
# Get these from the Cloudflare dashboard (Realtime > TURN).
# CLOUDFLARE_TURN_TOKEN_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Optional: credential lifetime in seconds (default 86400 = 24h).
# CLOUDFLARE_TURN_TTL=86400

# Option 2: static TURN server. Used only when Cloudflare TURN is not set.
# Comma-separated list of TURN URLs:
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=user
# TURN_CREDENTIAL=secret
